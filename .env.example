# Chain
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz

# Bridge
BRIDGE_PORT=4000
# Set to `memory` to run the bridge against an in-process fake chain (offline dev). Unset: live Monad testnet.
BRIDGE_CHAIN=
# Origin(s) the bridge allows for CORS, comma separated. `pnpm dev` serves web on :3000, docs/backend-handoff.md uses :3100.
BRIDGE_CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# Public base URL of the bridge, used in the `mcpUrl` returned by authorize. Unset: taken from the request (set it behind a proxy).
BRIDGE_PUBLIC_URL=
# Origin of the web app. With BRIDGE_PUBLIC_URL it turns on OAuth for claude.ai / Claude Desktop connectors (ADR-019): the bridge sends the owner to <this>/oauth/authorize to sign in.
BRIDGE_WEB_URL=
# Testnet-only key that tops up agent keys with MON (ADR-007). Never reuse it elsewhere and keep the balance small. Unset: no top-up.
BRIDGE_FUNDER_PRIVATE_KEY=
# HS256 secret for user and agent session tokens. Generate: openssl rand -hex 32
BRIDGE_JWT_SECRET=
# Supabase (bridge only, service role). Stores ciphertext, never plaintext.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Search by meaning (ADR-022, planned). Needs the memory_embedding migration. "on" downloads the model on first start.
HIVE_EMBEDDINGS=
HIVE_EMBED_MODEL=
HIVE_MODEL_CACHE_DIR=
HIVE_EMBED_MIN_SIM=

# Contracts (testnet only — do not commit real values)
DEPLOYER_PRIVATE_KEY=
MONADSCAN_API_KEY=

# Hive contract addresses (optional overrides; defaults come from @hive/shared deployments/monad-testnet.json)
NEXT_PUBLIC_HIVE_AGENT_REGISTRY=
NEXT_PUBLIC_HIVE_KNOWLEDGE_GRAPH=
NEXT_PUBLIC_HIVE_MEMORY_SLOTS=
NEXT_PUBLIC_HIVE_PROPAGATION_ENGINE=

# Web
# mock | live. Unset: `mock` in `next dev`, `live` in production builds.
# `mock` is a development scaffold only: production builds refuse to start with it (rules.md golden rule 8).
NEXT_PUBLIC_HIVE_MODE=
# Passkey relying party ID: the domain passkeys are bound to. Unset: the current hostname.
# Lock it before the demo; passkeys don't move between domains (docs/gotchas.md).
NEXT_PUBLIC_PASSKEY_RP_ID=
# Where the web app reaches the bridge (sign-in, agent sessions). Required in live mode.
NEXT_PUBLIC_BRIDGE_URL=http://localhost:4000
# Block explorer for every "View on Monadscan" link. Unset: https://testnet.monadscan.com
NEXT_PUBLIC_EXPLORER_URL=

# Web Monad gas
NEXT_PUBLIC_HIVE_GAS_MULTIPLIER=1.1

# Web dev-only signer fallback (local testing only)
NEXT_PUBLIC_HIVE_DEV_SIGNER=false
# Dev-only raw key (NEVER for production — bundled into the client)
NEXT_PUBLIC_HIVE_DEV_SIGNER_PRIVATE_KEY=

# DeepSeek agent runner (apps/agents, ADR-020). `mcpUrl` and the agent token come from authorizing a deepseek agent on the canvas.
HIVE_MCP_URL=
HIVE_TOKEN_DEEPSEEK=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Pick a current model from DeepSeek's docs; nothing is hard-coded.
DEEPSEEK_MODEL=
