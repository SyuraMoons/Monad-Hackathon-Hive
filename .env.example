# Chain
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz

# Bridge
BRIDGE_PORT=4000
NEXT_PUBLIC_BRIDGE_URL=http://localhost:4000

# Contracts (testnet only — do not commit real values)
DEPLOYER_PRIVATE_KEY=
MONADSCAN_API_KEY=

# Hive contract addresses (optional overrides; defaults come from @hive/shared deployments/monad-testnet.json)
NEXT_PUBLIC_HIVE_AGENT_REGISTRY=
NEXT_PUBLIC_HIVE_KNOWLEDGE_GRAPH=
NEXT_PUBLIC_HIVE_MEMORY_SLOTS=
NEXT_PUBLIC_HIVE_PROPAGATION_ENGINE=

# Web passkeys
NEXT_PUBLIC_MERA_RP_ID=localhost

# Web Monad gas
NEXT_PUBLIC_HIVE_GAS_MULTIPLIER=1.1

# Web dev-only signer fallback (local testing only)
NEXT_PUBLIC_HIVE_DEV_SIGNER=false
# Dev-only raw key (NEVER for production — bundled into the client)
NEXT_PUBLIC_HIVE_DEV_SIGNER_PRIVATE_KEY=
