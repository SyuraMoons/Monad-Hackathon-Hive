# Chain
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz

# Bridge
BRIDGE_PORT=4000

# Web
# mock | live. Unset: `mock` in `next dev`, `live` in production builds.
# `mock` is a development scaffold only: production builds refuse to start with it (rules.md golden rule 8).
NEXT_PUBLIC_HIVE_MODE=
# Passkey relying party ID: the domain passkeys are bound to. Unset: the current hostname.
# Lock it before the demo; passkeys don't move between domains (docs/gotchas.md).
NEXT_PUBLIC_PASSKEY_RP_ID=
# Where the web app reaches the bridge (sign-in, agent sessions). Required in live mode.
NEXT_PUBLIC_BRIDGE_URL=http://localhost:4000
# Block explorer for every "View on Monadscan" link. Unset: https://testnet.monadscan.com
NEXT_PUBLIC_EXPLORER_URL=
